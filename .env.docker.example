# =============================================================================
# LOCAL DOCKER (PROD-LIKE) ENVIRONMENT CONFIGURATION
# Copy to .env.docker.local and adjust if needed. DO NOT COMMIT .env.docker.local
# =============================================================================

APP_ENV=production_like
SECRET_KEY=local-docker-production-secret-key-at-least-32-chars-long

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chemistry_platform

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
S3_BUCKET=chemistry-storage

FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

OLLAMA_BASE_URL=http://host.docker.internal:11434
