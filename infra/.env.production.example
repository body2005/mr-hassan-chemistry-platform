# Copy outside Git and replace every path/domain with deployment-specific values.
# The secret files below must not be committed. Give only the Docker operator
# read access; TLS private key permissions should be especially restrictive.
PUBLIC_ORIGIN=https://chemistry.example.com
S3_ACCESS_KEY=chemistry-storage
S3_BUCKET=chemistry-materials
POSTGRES_USER=lms
POSTGRES_DB=lms
PRIVATE_SUBNET=172.30.120.0/24
BACKUP_DIR=/srv/chemistry-backups
POSTGRES_PASSWORD_FILE=/srv/chemistry-secrets/postgres_password
APP_SECRET_KEY_FILE=/srv/chemistry-secrets/app_secret_key
S3_PASSWORD_FILE=/srv/chemistry-secrets/s3_password
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailer@example.com
SMTP_FROM_EMAIL=mailer@example.com
SMTP_PASSWORD_FILE=/srv/chemistry-secrets/smtp_password
PAYMENT_INSTAPAY_ACCOUNT=replace-with-real-merchant-account
TLS_CERT_FILE=/srv/chemistry-secrets/fullchain.pem
TLS_KEY_FILE=/srv/chemistry-secrets/privkey.pem
