FROM python:3.12.15-slim-trixie@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016 AS native-security-build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/build_native_expat.sh /build/build_native_expat.sh
RUN sh /build/build_native_expat.sh

FROM python:3.12.15-slim-trixie@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# pyexpat is bundled into CPython; upgrading the OS libexpat alone does not
# repair it. Verify the official stable security release before installing.
RUN python -c "import pyexpat; assert pyexpat.version_info >= (2, 8, 5), pyexpat.EXPAT_VERSION"

WORKDIR /srv

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    openssl \
    libssl3t64 \
    build-essential \
    curl \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-ara \
    tesseract-ocr-eng \
    fonts-noto-core \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements.lock ./
COPY --from=native-security-build /build/libexpat1.deb /tmp/libexpat1.deb
RUN dpkg -i /tmp/libexpat1.deb && ldconfig && rm /tmp/libexpat1.deb
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1 \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip uninstall -y pip \
    && apt-get purge -y --auto-remove build-essential perl \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libssl3t64)" ge '3.5.7-1~deb13u3' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3' \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN python -m scripts.verify_native_expat
RUN chmod 755 scripts/tesseract_limited.py
ENV TESSERACT_CMD=/srv/scripts/tesseract_limited.py OMP_THREAD_LIMIT=1

# Run migrations, then start (command overridden by compose)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
