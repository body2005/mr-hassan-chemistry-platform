{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnapshotDedicatedPrivateApplicationBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET"
    },
    {
      "Sid": "ReadSnapshotPayloadOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/*"
    }
  ]
}
