# Test runner only; the browser matches the project's locked Playwright version.
FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
RUN apt-get update && apt-get install -y --no-install-recommends libnss3-tools docker.io python3-pypdf \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci && npm cache clean --force
COPY playwright.qa.config.ts ./
COPY tests ./tests
RUN mkdir -p /home/pwuser/.pki/nssdb && chown -R pwuser:pwuser /app /home/pwuser/.pki
USER pwuser
ENV QA_TRUSTED_BROWSER=true QA_ROUTE_LOCALHOST=host.docker.internal QA_PYTHON=/usr/bin/python3 TZ=Africa/Cairo
ENTRYPOINT ["/bin/sh", "/app/tests/qa/trusted-browser-entrypoint.sh"]
