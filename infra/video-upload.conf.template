# Dedicated upload-only gateway: no reads/list/admin/complete operations.
log_format upload_privacy '$remote_addr $request_method $uri $status $body_bytes_sent';
server {
    listen 443 ssl;
    ssl_certificate /run/secrets/tls_cert;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /dev/stdout upload_privacy;
    error_log /dev/null;
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $storage_upstream "${VIDEO_S3_HOST}";
    client_max_body_size 32m;
    client_body_timeout 120s;
    add_header Access-Control-Allow-Origin "${PUBLIC_ORIGIN}" always;
    add_header Access-Control-Allow-Methods "PUT, OPTIONS" always;
    add_header Access-Control-Allow-Headers "content-type" always;
    add_header Access-Control-Expose-Headers "ETag" always;
    add_header Vary "Origin" always;
    add_header Cache-Control "no-store" always;
    location = /healthz { return 200 "ok\n"; }
    location ~ "^/${S3_BUCKET}/video-staging/[0-9a-f-]{36}/source\.(mp4|m4v|mov|webm)$" {
        if ($request_method = OPTIONS) { return 204; }
        if ($request_method != PUT) { return 405; }
        if ($arg_uploadId = "") { return 403; }
        if ($arg_partNumber = "") { return 403; }
        proxy_pass http://$storage_upstream:8333;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 3s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
    location / { return 403; }
}
