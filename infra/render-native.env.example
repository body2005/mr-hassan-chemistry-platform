# Preparation for the EXISTING native Python service, not a deployed Blueprint.
# Copy values privately in Render; REPLACE_* values are not deployable.
APP_ENV=production
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=REPLACE_WITH_HTTPS_STORAGE_ORIGIN
S3_BUCKET_NAME=REPLACE_WITH_DEDICATED_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_API_SCOPED_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_API_SCOPED_SECRET
S3_REGION=auto
REDIS_REQUIRED=true
REDIS_URL=REPLACE_WITH_EXISTING_PRIVATE_VALKEY_URL
# Knowledge Center ingestion is removed; the encoder reads PostgreSQL jobs.
INGESTION_BACKEND=disabled
VIDEO_PROCESSING_ENABLED=true
VIDEO_DIRECT_UPLOAD_ENABLED=true
VIDEO_UPLOAD_PUBLIC_ENDPOINT=REPLACE_WITH_DEPLOYED_HTTPS_UPLOAD_GATEWAY_ORIGIN
FRONTEND_ORIGINS=https://mr-hassan-chemistry-platform.vercel.app
# Resolve actual upstream proxy CIDRs first; never use '*'.
TRUSTED_PROXIES=REPLACE_WITH_VERIFIED_PROXY_CIDRS
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_FROM_EMAIL=REPLACE_WITH_RESEND_VERIFIED_SENDER
RESEND_API_KEY=REPLACE_WITH_SENDING_ONLY_KEY
# Keep off until the separate RLS rollout is authorized and verified.
RLS_CONTEXT_ENABLED=false
