{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApplicationBucketMetadataAndMultipartRecovery",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET"
    },
    {
      "Sid": "ListOnlyApplicationPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["lesson_videos/*", "lesson_materials/*", "payment_receipts/*", "assignment_submissions/*", "video-staging/*", "video-assets/*", "video-originals/*", ".probes/*"]}}
    },
    {
      "Sid": "PrivateApplicationObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/lesson_videos/*",
        "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/lesson_materials/*",
        "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/payment_receipts/*",
        "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/assignment_submissions/*",
        "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/video-staging/*",
        "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/video-assets/*",
        "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/video-originals/*",
        "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/.probes/*"
      ]
    }
  ]
}
