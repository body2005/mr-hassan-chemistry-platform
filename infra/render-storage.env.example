# Render API environment only. Never add these credentials to Vercel/VITE_*.
# Create a PRIVATE bucket and replace every CHANGE_ME before activation.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
S3_BUCKET_NAME=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=auto
# Keep both disabled until the PC worker passes its prerequisite check.
VIDEO_PROCESSING_ENABLED=false
VIDEO_DIRECT_UPLOAD_ENABLED=false
