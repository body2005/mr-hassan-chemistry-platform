# Dedicated encoder: FFmpeg is not installed in the API image.
ARG API_VIDEO_IMAGE=chemistryprodlocal-api
FROM python:3.12.15-slim-trixie@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016 AS encoder-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config nasm libx264-dev curl ca-certificates xz-utils gnupg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/build_native_ffmpeg.sh /build/build_native_ffmpeg.sh
RUN sh /build/build_native_ffmpeg.sh

FROM ${API_VIDEO_IMAGE}
COPY --from=encoder-build /build/ffmpeg.deb /tmp/ffmpeg.deb
RUN apt-get update && apt-get install -y --no-install-recommends libx264-164 \
    && dpkg -i /tmp/ffmpeg.deb && rm /tmp/ffmpeg.deb \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /work && chown 10001:10001 /work
COPY . .
RUN python -m scripts.verify_native_expat \
    && ! ldd /usr/bin/ffmpeg | grep -E 'libcjson|librsvg' \
    && ! dpkg-query -W libcjson1 librsvg2-2 2>/dev/null
USER 10001:10001
CMD ["python", "-m", "scripts.video_worker"]
