# Copy through scripts/start-video-worker.ps1. Never commit the resulting file.
# Values are literal: do not put quotes around them. Keep credentials on one line.
# This worker does not need the API session-signing secret or any email API key.
SECRET_KEY=GENERATED_BY_START_SCRIPT
FRONTEND_ORIGINS=https://mr-hassan-chemistry-platform.vercel.app
# Shared production Settings require a payment destination. Copy the already
# configured public payment details from the API; this worker never takes payments.
PAYMENT_BANK_DETAILS=CHANGE_ME
# Use Render's EXTERNAL PostgreSQL URL, with TLS, not its private/internal host.
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@CHANGE_ME/CHANGE_ME?sslmode=require
# Same bucket as the Render API; use a separate encoder-scoped credential.
# See s3-video-worker-policy.json.example. Do not share the API or mail key.
S3_ENDPOINT_URL=https://CHANGE_ME
S3_BUCKET_NAME=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=auto
