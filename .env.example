# Educational LMS Platform — environment template.
# Copy to .env and fill real values. NEVER commit real secrets.

# --- Core ---
APP_ENV=development            # development | testing | staging | production
SECRET_KEY=change-me-to-a-64-char-random-string-before-any-deployment
FRONTEND_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL is the source of truth) ---
DATABASE_URL=postgresql+asyncpg://lms:CHANGE_ME@localhost:5432/lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lms

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=lms-storage
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=lms-files
MINIO_ROOT_USER=lms-storage
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- AI providers ---
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_PROVIDER=ollama
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- OCR Engine ---
# Tesseract OCR executable path (optional if already in system PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Multimodal Chemistry & RAG Model Roles ---
# Swappable model roles for indexing, vision, embedding, QA, and answer verification
INDEXING_MODEL=openrouter-free
VISION_MODEL=openrouter-free
EMBEDDING_MODEL=text-embedding-3-small
QA_MODEL=openrouter-free
VERIFIER_MODEL=openrouter-free
CHEMISTRY_STRICT_GROUNDING=true
