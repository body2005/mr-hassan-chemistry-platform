# Educational LMS Platform — environment template.
# Copy to .env and fill real values. NEVER commit real secrets.

# --- Core ---
APP_ENV=development            # development | testing | staging | production
SECRET_KEY=change-me-to-a-64-char-random-string-before-any-deployment
FRONTEND_ORIGINS=http://localhost:5173

# Email delivery is optional. Keep off when no emails should be sent.
EMAIL_ENABLED=false
# Render Free: enable Resend HTTPS after configuring a sending key/sender.
EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-private-sending-key
# EMAIL_FROM_EMAIL=no-reply@your-verified-domain.example
# SMTP remains available with EMAIL_PROVIDER=smtp and SMTP_HOST, SMTP_USER,
# SMTP_PASSWORD, SMTP_FROM_EMAIL and an implicit-TLS port (default 465).

# Optional, private student previews: student01/02/03@demo.com (one per grade).
# Requires an existing institution and a private password of at least 12 chars.
# Existing identities/passwords are never changed. Disable after the seed runs.
SEED_PREVIEW_STUDENTS=false
# INITIAL_INSTITUTION_SLUG=demo
# DEMO_STUDENT_PASSWORD=choose-a-private-password-outside-git

# --- Database (PostgreSQL is the source of truth) ---
DATABASE_URL=postgresql+asyncpg://lms:CHANGE_ME@localhost:5432/lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lms

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=lms-storage
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=lms-files
MINIO_ROOT_USER=lms-storage
MINIO_ROOT_PASSWORD=CHANGE_ME

# Enable only after a separate FFmpeg worker is connected to the same DB/store.
# Existing saved videos: teacher action "تجهيز الجودات"; no re-upload needed.
VIDEO_PROCESSING_ENABLED=false

# --- OCR Engine ---
# Tesseract OCR executable path (optional if already in system PATH)
# Used only by quiz question extraction from scanned files.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
