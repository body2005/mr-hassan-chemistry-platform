# LMS AI Service Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True
API_KEY=

# Active AI Provider: 'ollama' (Local Open-Source default) | 'external' | 'mock'
AI_PROVIDER=ollama

# Admission Control & 8GB GPU Guard
MAX_CONCURRENT_INTERACTIVE_INFERENCES=2
SEMAPHORE_TIMEOUT_SECONDS=25.0
RATE_LIMIT_PER_MINUTE=60

# Redis Cache TTLs (seconds)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=True
TTL_QUIZ_CACHE=86400
TTL_GRADING_CACHE=172800
TTL_REPORT_CACHE=86400
TTL_ANALYTICS_CACHE=21600

# Local Ollama Provider Settings (Qwen2.5-7B-Instruct Q4_K_M)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=60.0

# Optional External API Settings (Unused when AI_PROVIDER=ollama)
EXTERNAL_BASE_URL=https://api.openai.com/v1
EXTERNAL_API_KEY=
EXTERNAL_MODEL=gpt-4o-mini
EXTERNAL_EMBED_MODEL=text-embedding-3-small
EXTERNAL_REQUEST_TIMEOUT=45.0

# Vector Storage (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lms_ai
VECTOR_SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=4

# Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Swappable Model Roles (Chemistry & Multimodal RAG)
INDEXING_MODEL=openrouter-free
VISION_MODEL=openrouter-free
EMBEDDING_MODEL=text-embedding-3-small
QA_MODEL=openrouter-free
VERIFIER_MODEL=openrouter-free
CHEMISTRY_STRICT_GROUNDING=True
